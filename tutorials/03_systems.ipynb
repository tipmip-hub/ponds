   "metadata": {},
   "outputs": [],
   "source": [
    "ground_state = \"periodic_1\"  # periodic state\n",
    "ground_value = system.get_parameter_value(state=ground_state)\n",
    "\n",
    "pond.add_background(\n",
    "    background_method=Trend(\n",
    "        slope=0,\n",
    "        intercept=ground_value,\n",
    "    )\n",
    ")"
   ]
  },
