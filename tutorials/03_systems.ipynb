   "source": [
    "# Detecting nonlinear shifts with toad"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "7c900c01",
   "metadata": {},
   "outputs": [],
   "source": [
    "from toad import TOAD\n",
    "from toad.shifts import NONLINEAR\n",
    "from sklearn.cluster import HDBSCAN\n",
    "from toad.visualisation.toad_plotter import PlotConfig"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "5246cf25",
   "metadata": {},
   "outputs": [],
   "source": [
    "td = TOAD(pond.data)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3a84c87d",
   "metadata": {},
   "source": [
    "now use toad to detect shifts (runs around 2-3 mins) and do clustering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "8c142d36",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "INFO: New shifts variable \u001b[1mlorenz_ts_dts\u001b[0m: min/mean/max=-0.442/-0.011/0.192 using 800 grid cells. Skipped 0.0% grid cells: 0 NaN, 0 constant.\n"
     ]
    }
   ],
   "source": [
    "# compute shifts\n",
    "nonlinear_param_dict = {\n",
    "    \"window_size\": 200,\n",
    "    \"window_step\": 20,\n",
    "    \"recurrence_rate\": 0.05,\n",
    "    \"embedding_dim\": 2,\n",
    "    \"embedding_tau\": 10,\n",
    "    \"recurrence_measure\": \"transitivity\",\n",
    "    \"lmin\": 5,\n",
    "}\n",
    "\n",
    "td.compute_shifts(\n",
    "    \"lorenz_ts\",\n",
    "    NONLINEAR(**nonlinear_param_dict),\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "9b940394",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "INFO: New cluster variable \u001b[1mlorenz_ts_dts_cluster\u001b[0m: Identified \u001b[1m2 clusters\u001b[0m in 29 pts; Left 0.0% as noise (0 pts).\n"
     ]
    }
   ],
   "source": [
    "# do clustering\n",
    "td.compute_clusters(\n",
    "    \"lorenz_ts\",\n",
    "    HDBSCAN(),\n",
    "    shift_threshold=0.2,  # choose threshold from [0,1]\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "33abb00d",
   "metadata": {},
   "outputs": [
    {
     "data": {
