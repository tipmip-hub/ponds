   ],
   "source": [
    "plt.rcParams[\"figure.dpi\"] = 300\n",
    "\n",
    "plotter = td.plot(\n",
    "    PlotConfig(\n",
    "        map_frame=False,\n",
    "        grid_labels=False,\n",
    "    )\n",
    ")\n",
    "\n",
    "plotter.cluster_overview(\n",
    "    \"lorenz_ts_dts\",\n",
    "    range(10),\n",
    "    cmap=\"tab10\",\n",
    "    timeseries_kwargs={},\n",
    "    map_kwargs={\"add_contour\": False},\n",
    "    figsize=(16, 5),\n",
    ")\n",
    "\n",
    "# plot clustered detection timeseries\n",
    "fig, axs = plt.subplots(2, 1, figsize=(16, 4))\n",
    "plotter.cluster_timeseries(\"lorenz_ts_dts\", td.get_cluster_ids(\"lorenz_ts\"), ax=axs[0])\n",
    "\n",
    "# plot all detection timeseries\n",
    "td.data.lorenz_ts_dts.toad.to_timeseries().plot.line(\n",
