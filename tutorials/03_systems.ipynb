    "# add shift-blob with custom parameters\n",
    "shifted_state = \"chaotic_1\"  # chaotic state\n",
    "shifted_value = system.get_parameter_value(state=shifted_state)\n",
    "\n",
    "shift_dict = {\n",
    "    \"shift_seed\": 1,\n",
    "    \"shift_steepness\": 0.2,\n",
    "    \"shift_magnitude\": shifted_value - ground_value,\n",
    "}\n",
    "pond.add_shift(\n",
    "    shape_method=ELLIPSIS(shape_seed=6),\n",
    "    shift_method=SIGMOID(**shift_dict),\n",
    ")\n",
    "\n",
    "\n",
    "# add another shift-blob with custom parameters\n",
    "shifted_state = \"chaotic_1\"  # different chaotic state\n",
    "shifted_value = system.get_parameter_value(state=shifted_state)\n",
    "\n",
    "shift_dict = {\n",
    "    \"shift_seed\": 2,\n",
    "    \"shift_steepness\": 0.2,\n",
    "    \"shift_magnitude\": shifted_value - ground_value,\n",
    "}\n",
    "pond.add_shift(\n",
    "    shape_method=ELLIPSIS(shape_seed=7),\n",
    "    shift_method=SIGMOID(**shift_dict),\n",
    ")"
   ]
  },
